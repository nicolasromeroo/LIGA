# Copiá este archivo a .env (o .env.local) y ajustá el valor si hace falta.
# .env nunca se commitea.

# URL base del backend (LIGA-Server). También se usa para el socket de PvP
# (api/socket.js reutiliza la misma URL). Sin esta variable, el front cae en
# http://localhost:3000 — sirve para desarrollo local, pero en cualquier
# build de producción hay que definirla explícitamente.
VITE_API_URL="http://localhost:3000"
